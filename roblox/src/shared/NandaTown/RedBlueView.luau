-- RedBlueView: the client side of Red vs. Blue (live). It draws the server's
-- live TownSim stream with the replay's own visual vocabulary (Replay.stage:
-- couriers and envelopes, coins and the vault, stars, the gate's guards, the
-- notice board, the ticker), and adds what the game needs on top:
--
--   * cards pinned on the notice board as papers you can click
--   * forged invoices parked on a buyer's desk until their payout
--   * the guards walking off / back and a padlock on the board, when the
--     council swaps auth or registry
--   * catches, escapes and false alarms drawn where they happen
--   * the game HUD: scores, red's tokens, the round clock, the council's
--     laws with vote buttons, what your team does, personal notices
--   * blue's flagging: click (or tap) near a courier or a card; the nearest
--     one on screen within PICK_PX is sent to the server by id
--   * the model-driven agents: a violet nameplate under the figure's own
--     ("seller-b" / "gemini-2.5-flash"), and a panel saying what the model
--     last decided and why. L switches them between scripted and
--     model-driven. Both are rendered from the game's own vocabulary (see
--     RedBlue/LlmPolicy.luau): no model-written text reaches the screen.
--
-- Every word on screen is generated by the game: no player-typed text.
-- Automation (MCP execute_luau on client-1), all through the same code paths
-- as a mouse: workspace attribute RBClickAt = Vector2 (a click at that
-- viewport point), RBVote = "auth" | "registry" (the vote button), RBLlm =
-- "toggle" | "off" (the L key). The view reports RBTeam, RBHover (the id
-- under the mouse), RBLastNotice and RBFlaggables (how many clickable things
-- are on screen) back as attributes.

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Util = require(script.Parent.Util)
local Replay = require(script.Parent.Replay)
local Config = require(script.Parent.RedBlue.Config)

local View = {}
View.__index = View

View.PICK_PX = 44
-- red's impostor stall: inside the gate, left of buyer-1, clear of the gate's
-- labels in the overview (placement checked in Studio, 2026-10-21)
View.RED_STALL = Vector3.new(-58, 0.2, 28)
View.GUARD_POST_OFFSET = Vector3.new(9, 0, -15) -- off duty: out on the plaza, away from the gate

local RED = Color3.fromRGB(235, 60, 60)
local BLUE = Color3.fromRGB(70, 140, 255)
local GOLD = Color3.fromRGB(250, 190, 60)
local PANEL = Color3.fromRGB(18, 18, 24)
local VIOLET = Color3.fromRGB(185, 130, 255) -- model-driven, everywhere it shows

local function hex(c: Color3): string
	return string.format("#%02x%02x%02x", math.floor(c.R * 255), math.floor(c.G * 255), math.floor(c.B * 255))
end

local function participants()
	local list = {}
	for _, s in Config.SELLERS do
		table.insert(list, { name = s, role = "seller" })
	end
	for _, b in Config.BUYERS do
		table.insert(list, { name = b, role = "buyer" })
	end
	table.insert(list, { name = Config.ATTACKER, role = "attacker" })
	return list
end

local function myTeam(): string?
	local t = Players.LocalPlayer.Team
	if t and t.Name == "Red" then
		return "red"
	elseif t and t.Name == "Blue" then
		return "blue"
	end
	return nil
end

------------------------------------------------------------------------ start / stop

-- opts = { playerGui, camera, rect: () -> {x,y,w,h}, getMode: () -> string,
--          onTown: (town) -> () }
function View.start(opts)
	local self = setmetatable({
		opts = opts,
		conns = {},
		flaggables = {}, -- part -> id
		lastPos = {}, -- id -> Vector3 (where it was last seen)
		cards = {}, -- ordered list of { id, name, price, verified, part }
		myVotes = {},
		layers = { auth = Config.DEFAULT_LAYERS.auth, registry = Config.DEFAULT_LAYERS.registry },
		stopped = false,
	}, View)
	self.remotes = ReplicatedStorage:WaitForChild("NandaRedBlue", 10)
	if not self.remotes then
		warn("[RedBlueView] no NandaRedBlue remotes")
		return self
	end
	self:buildHud()
	self:connect(self.remotes:WaitForChild("Events").OnClientEvent, function(batch)
		self:receive(batch)
	end)
	self:connect(self.remotes:WaitForChild("Notice").OnClientEvent, function(n)
		self:notice(n)
	end)
	self:bindInput()
	self.remotes:WaitForChild("Hello"):FireServer()
	return self
end

function View:connect(signal, fn)
	table.insert(self.conns, signal:Connect(fn))
end

function View:stop()
	self.stopped = true
	for _, c in self.conns do
		c:Disconnect()
	end
	table.clear(self.conns)
	if self.gui then
		self.gui:Destroy()
	end
	if self.selection then
		self.selection:Destroy()
	end
	-- Replay.run (the replay coming back) rebuilds the town and HUD itself
end

------------------------------------------------------------------------ the town

function View:build(layers)
	self.layers.auth = layers.auth or self.layers.auth
	self.layers.registry = layers.registry or self.layers.registry
	local trace = {
		scenario = "red vs blue (live)",
		seed = 0,
		run_id = "live",
		layers = {
			auth = self.layers.auth,
			registry = self.layers.registry,
			transport = layers.transport or "memory.v1",
			negotiation = "haggle.v1",
			payments = "ledger.v1",
			trust = "reputation.v1",
			data_facts = "evidence.v1",
		},
		participants = participants(),
		events = {},
		messages = {},
	}
	if Replay.current then
		Replay.current.cancelled = true -- the replay's runner, if one is going
		Replay.current = nil
	end
	Util.startClock(nil) -- free-running: live events are drawn when they arrive
	Util.speed = 1
	table.clear(self.flaggables)
	table.clear(self.cards)
	self.stage = Replay.stage(trace, {
		live = true,
		parent = workspace,
		guiParent = self.opts.playerGui,
		hudRect = self.opts.rect(),
		title = "NANDA Town  ·  LIVE  ·  red vs. blue",
		bannerY = 150, -- under the scoreboard and the notices
		subtitle = "a Luau re-implementation of the marketplace, running on this server",
		legend = "\n✉ courier = a message on the road\n● coins = money · ★ = reputation\n<font color='#ff8080'>red-team</font> stall: where red's money lands",
	})
	self.town = self.stage.town
	self.ctx = self.stage.ctx
	self:placeRedStall()
	self:prepareGuards()
	self:buildLock()
	self:install()
	self:applyLayers(false)
	if self.opts.onTown then
		self.opts.onTown(self.town)
	end
end

function View:placeRedStall()
	local a = self.town.agents[Config.ATTACKER]
	if not a then
		return
	end
	-- move the figure from the middle of the road to the stall, turned about its
	-- feet to face the square
	local delta = View.RED_STALL - a.pos
	local feet = CFrame.new(View.RED_STALL)
	local turned = feet * CFrame.Angles(0, math.rad(-50), 0)
	for _, p in a.model:GetDescendants() do
		if p:IsA("BasePart") then
			p.CFrame = turned * feet:ToObjectSpace(p.CFrame + delta)
		end
	end
	a.pos = View.RED_STALL
	a.chest = a.pos + Vector3.new(0, 5.5, 0)
	a.top = a.pos + Vector3.new(0, 13, 0)
	-- a little shady awning, so it reads as a stall
	local m = Instance.new("Model")
	m.Name = "Red stall"
	m.Parent = self.town.root
	local c = View.RED_STALL
	Util.part({ Name = "Counter", Size = Vector3.new(8, 3, 2.4), CFrame = CFrame.new(c + Vector3.new(0, 1.5, -4)), Color = Color3.fromRGB(70, 30, 30), Material = Enum.Material.WoodPlanks, CanCollide = true, Parent = m })
	Util.part({ Name = "Awning", Size = Vector3.new(9, 0.5, 4), CFrame = CFrame.new(c + Vector3.new(0, 10.5, -3)), Color = Color3.fromRGB(120, 20, 20), Parent = m })
	for _, dx in { -4, 4 } do
		Util.part({ Name = "Pole", Size = Vector3.new(0.5, 10.5, 0.5), CFrame = CFrame.new(c + Vector3.new(dx, 5.25, -4.8)), Color = Color3.fromRGB(60, 40, 30), CanCollide = true, Parent = m })
	end
end

-- the gate's two guards, and where they stand on duty
function View:prepareGuards()
	self.guards = {}
	local gate = self.town.buildings.auth
	for _, p in gate.model:GetChildren() do
		if p:IsA("BasePart") and (p.Name == "Guard" or p.Name == "GuardHead") then
			table.insert(self.guards, { part = p, duty = p.CFrame })
		end
	end
end

function View:buildLock()
	local reg = self.town.buildings.registry
	local board = reg.board :: BasePart
	local m = Instance.new("Model")
	m.Name = "Padlock"
	-- on the right of the board's face, clear of the three columns of cards
	local top = board.CFrame * CFrame.new(board.Size.X / 2 - 1.9, 0.6, board.Size.Z / 2 + 0.5)
	local body = Util.part({ Name = "Body", Size = Vector3.new(2.6, 2.2, 0.8), CFrame = top, Color = GOLD, Material = Enum.Material.Metal, Parent = m })
	body.Reflectance = 0.3
	for _, dx in { -0.8, 0.8 } do
		Util.part({ Name = "Shackle", Size = Vector3.new(0.4, 1.6, 0.4), CFrame = top * CFrame.new(dx, 1.7, 0), Color = Color3.fromRGB(200, 200, 210), Material = Enum.Material.Metal, Parent = m })
	end
	Util.part({ Name = "ShackleTop", Size = Vector3.new(2.0, 0.4, 0.4), CFrame = top * CFrame.new(0, 2.5, 0), Color = Color3.fromRGB(200, 200, 210), Material = Enum.Material.Metal, Parent = m })
	m.Parent = self.town.root
	self.lock = m
	self.lockParts = {}
	for _, p in m:GetChildren() do
		self.lockParts[p] = p.CFrame
	end
end

-- Show the current layers on the buildings: guards on duty or off, the lock
-- on the board or not, and the signposts' subtitles. animate = walk/drop.
function View:applyLayers(animate: boolean)
	local hmac = self.layers.auth == "hmac.v1"
	local owned = self.layers.registry == "index.owned.v1"
	for _, g in self.guards or {} do
		local from = g.part.CFrame
		local to = hmac and g.duty or (g.duty + View.GUARD_POST_OFFSET)
		if animate then
			Util.animate(2.6, function(a)
				local e = Util.ease(a)
				local hop = math.abs(math.sin(a * math.pi * 6)) * 0.6 -- footsteps
				g.part.CFrame = from:Lerp(to, e) + Vector3.new(0, hop, 0)
			end, function()
				g.part.CFrame = to
				g.part.Transparency = hmac and 0 or 0.35
			end)
		else
			g.part.CFrame = to
			g.part.Transparency = hmac and 0 or 0.35
		end
	end
	for p, cf in self.lockParts or {} do
		if owned then
			if animate then
				Util.animate(0.8, function(a)
					p.CFrame = cf + Vector3.new(0, (1 - Util.ease(a)) * 8, 0)
					p.Transparency = 1 - a
				end, function()
					p.CFrame = cf
					p.Transparency = 0
				end)
			else
				p.CFrame = cf
				p.Transparency = 0
			end
		else
			p.Transparency = 1
		end
	end
	self:setSub(self.town.buildings.auth, "auth · ", "auth · " .. self.layers.auth .. (hmac and " · guards on duty" or " · NO GUARDS"))
	self:setSub(self.town.buildings.registry, "registry · ", "registry · " .. self.layers.registry .. (owned and " · 🔒 owned" or " · open"))
	local gate = self.town.buildings.auth
	if gate.panel and not hmac then
		gate.panel.Text = "off duty: plain.v1 checks nothing"
	elseif gate.panel and (gate.stopped or 0) == 0 then
		gate.panel.Text = "none so far"
	end
end

function View:setSub(building, prefix: string, text: string)
	for _, d in building.model:GetDescendants() do
		if d:IsA("TextLabel") and string.sub(d.Text, 1, #prefix) == prefix then
			d.Text = text
		end
	end
end

------------------------------------------------------------------------ flaggables

function View:addFlaggable(part: BasePart?, id: string)
	if part then
		self.flaggables[part] = id
		self.lastPos[id] = part.Position
	end
end

function View:where(id: string): Vector3?
	for part, fid in self.flaggables do
		if fid == id and part.Parent then
			return part.Position
		end
	end
	return self.lastPos[id]
end

-- The flaggable nearest to a viewport point, within PICK_PX.
function View:pick(screen: Vector2): (string?, BasePart?)
	local cam = workspace.CurrentCamera
	local best, bestPart, bestD = nil, nil, View.PICK_PX
	for part, id in self.flaggables do
		if not part.Parent then
			self.flaggables[part] = nil
		elseif part.Transparency < 0.95 then
			local v, on = cam:WorldToViewportPoint(part.Position)
			if on then
				local d = (Vector2.new(v.X, v.Y) - screen).Magnitude
				if d < bestD then
					best, bestPart, bestD = id, part, d
				end
			end
		end
	end
	return best, bestPart
end

------------------------------------------------------------------------ cards

local PAPER_W, PAPER_H = 3.8, 2.6

function View:layoutCards()
	local board = self.town.buildings.registry.board :: BasePart
	local cols = 3
	for i, c in self.cards do
		local col, row = (i - 1) % cols, (i - 1) // cols
		-- the town-facing side of the board is +z; turned half round, a paper's
		-- Front face (its SurfaceGui) faces the square, read left to right
		local cf = board.CFrame
			* CFrame.new(-board.Size.X / 2 + 2.6 + col * (PAPER_W + 0.6), board.Size.Y / 2 - 2.0 - row * (PAPER_H + 0.5), board.Size.Z / 2 + 0.12)
			* CFrame.Angles(0, math.pi, 0)
		if c.part and c.part.Parent then
			c.part.CFrame = cf
		end
	end
	self:refreshCardPanel()
end

function View:refreshCardPanel()
	local reg = self.town.buildings.registry
	local lines = {}
	for _, c in self.cards do
		table.insert(lines, string.format("%s <b>%s</b>  %s%s", c.verified and "<font color='#1a8a2a'>✓</font>" or "<font color='#d02020'>✗</font>", c.name, Util.money(c.price), c.verified and "" or "  <font color='#d02020'>UNVERIFIED</font>"))
	end
	reg.panel.Text = table.concat(lines, "\n")
end

function View:pinCard(e, verified: boolean)
	local reg = self.town.buildings.registry
	local id = e.card or ("card?" .. e.seq)
	for _, c in self.cards do
		if c.id == id then
			return -- already pinned (snapshot after a live event)
		end
	end
	local color = verified and Color3.fromRGB(250, 250, 238) or Color3.fromRGB(255, 170, 170)
	local p = Util.part({ Name = "Card " .. id, Size = Vector3.new(PAPER_W, PAPER_H, 0.15), Color = color, Parent = self.town.root })
	local g = Instance.new("SurfaceGui")
	g.Face = Enum.NormalId.Front
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = 40
	g.LightInfluence = 0
	g.Parent = p
	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = color
	bg.BorderSizePixel = 0
	bg.Parent = g
	Util.label(bg, { Text = tostring(e.subject), Size = UDim2.fromScale(1, 0.45), TextScaled = true, Font = Util.FONT_HEAVY, TextColor3 = Color3.fromRGB(25, 25, 25) })
	Util.label(bg, { Text = "sell.widget · " .. Util.money(e.price), Position = UDim2.fromScale(0, 0.45), Size = UDim2.fromScale(1, 0.28), TextScaled = true, Font = Util.FONT_BOLD, TextColor3 = Color3.fromRGB(60, 60, 60) })
	Util.label(bg, {
		Text = verified and "✓ signed" or "✗ UNVERIFIED",
		Position = UDim2.fromScale(0, 0.72),
		Size = UDim2.fromScale(1, 0.26),
		TextScaled = true,
		Font = Util.FONT_HEAVY,
		TextColor3 = verified and Color3.fromRGB(30, 130, 40) or Color3.fromRGB(200, 20, 20),
	})
	local card = { id = id, name = tostring(e.subject), price = e.price or 0, verified = verified, part = p }
	table.insert(self.cards, card)
	self:layoutCards()
	self:addFlaggable(p, id)
	-- fly in from the publisher (red's stall for a spoof, the seller otherwise)
	local dest = p.CFrame
	if not e.snapshot then
		local from = self.ctx.posOf(e.detail.publisher or e.subject)
		Util.animate(1.0, function(a)
			p.CFrame = CFrame.new(from:Lerp(dest.Position, Util.ease(a)) + Vector3.new(0, math.sin(a * math.pi) * 8, 0)) * dest.Rotation
		end, function()
			if p.Parent then
				self:layoutCards()
			end
		end)
		Replay.effects.flash(reg, verified and Util.LAYER_COLORS.registry or Color3.fromRGB(255, 60, 60))
	end
end

function View:unpinCard(id: string, why: string)
	for i, c in self.cards do
		if c.id == id then
			table.remove(self.cards, i)
			local p = c.part
			self.lastPos[id] = p.Position
			local start = p.CFrame
			Util.animate(1.0, function(a)
				p.CFrame = start * CFrame.new(0, -a * a * 8, -a * 1.5) * CFrame.Angles(a * 1.2, 0, a * 0.8)
				p.Transparency = a * 0.8
			end, function()
				p:Destroy()
			end)
			self.flaggables[p] = nil
			break
		end
	end
	self:layoutCards()
end

------------------------------------------------------------------------ handlers

function View:install()
	local h = self.stage.handlers
	local ctx = self.ctx
	local fx = self.stage.fx
	local E = Replay.effects
	local town = self.town

	local function floatAt(pos: Vector3?, text: string, color: Color3, life: number?)
		if pos then
			E.floater(fx, pos + Vector3.new(0, 3, 0), text, color, life or 2.8)
		end
	end
	self.floatAt = floatAt

	local function burst(pos: Vector3?, color: Color3)
		if not pos then
			return
		end
		local s = Util.part({ Name = "Burst", Shape = Enum.PartType.Ball, Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(pos), Color = color, Material = Enum.Material.Neon, Transparency = 0.2, Parent = fx })
		Util.animate(0.7, function(a)
			s.Size = Vector3.one * (1 + 14 * a)
			s.Transparency = 0.2 + 0.8 * a
		end, function()
			s:Destroy()
		end)
	end

	h.card_registered = function(e)
		self:pinCard(e, e.detail.verified ~= false)
	end
	h.card_unverified = function(e)
		self:pinCard(e, false)
	end
	h.card_withdrawn = function(e)
		self:unpinCard(e.card, e.detail.reason)
		Replay.effects.flash(town.buildings.registry, Color3.fromRGB(255, 200, 60))
	end
	h.card_publish_refused = function(e)
		-- a paper flies from red's stall, hits the lock and drops
		local reg = town.buildings.registry
		local paper = Util.part({ Name = "RefusedCard", Size = Vector3.new(PAPER_W, 0.2, PAPER_H), Color = Color3.fromRGB(255, 150, 150), Material = Enum.Material.Neon, Parent = fx })
		local from = ctx.posOf(e.detail.publisher)
		local to = reg.anchor + Vector3.new(0, 0, 2)
		Util.fly(paper, from, to, 10, 1.0, function()
			floatAt(to, "🔒 REFUSED", Color3.fromRGB(255, 90, 90))
			local start = paper.Position
			Util.animate(0.8, function(a)
				paper.CFrame = CFrame.new(start + Vector3.new(0, -a * a * 7, a * 4)) * CFrame.Angles(a * 3, 0, a * 2)
			end, function()
				paper:Destroy()
			end)
		end)
		Replay.effects.flash(reg, Color3.fromRGB(255, 60, 60))
	end

	local sigOrig = h.signature_invalid
	h.signature_invalid = function(e)
		if e.card then
			local reg = town.buildings.registry
			floatAt(reg.anchor + Vector3.new(0, 2, 2), "✗ not signed by " .. tostring(e.detail.claimed), Color3.fromRGB(255, 80, 80), 3.2)
			Replay.effects.flash(reg, Color3.fromRGB(255, 60, 60))
		else
			sigOrig(e)
		end
	end

	local failOrig = h.delivery_failed
	h.delivery_failed = function(e)
		if e.detail.reason == "signature_invalid" then
			-- let everyone see it start at the gate, then the guards stop it
			Util.delay(0.9, function()
				failOrig(e)
			end)
		else
			failOrig(e)
		end
	end

	h.registry_lookup = function(e)
		E.setBubble(ctx.agent(e.observer), e.detail.owned_check and "🔎 notice board… 🔒 checking keys" or "🔎 notice board: who sells widgets?", 2.2, Color3.fromRGB(220, 245, 220))
		Replay.effects.flash(town.buildings.registry)
	end

	-- An impostor's deal is drawn to red's stall, where its couriers really go
	-- (the ticker still says what the town recorded: the name on the card).
	local lastDest = {} -- buyer -> where its last quote request really went
	local function asImpostor(e, field: string, value: string)
		local c = table.clone(e)
		c.detail = table.clone(e.detail)
		c.detail[field] = value
		return c
	end
	local negOrig = h.negotiation_started
	h.negotiation_started = function(e)
		local dest = lastDest[e.observer]
		negOrig(dest and asImpostor(e, "seller", dest) or e)
	end
	local counterOrig = h.counter_made
	h.counter_made = function(e)
		if e.origin then
			E.setBubble(ctx.agent(e.origin), string.format("Counter: %s¢", tostring(e.detail.cents)), 3.4, Color3.fromRGB(255, 215, 170))
		else
			counterOrig(e)
		end
	end

	local sentOrig = h.message_sent
	h.message_sent = function(e)
		if e.detail.kind == "quote_request" then
			lastDest[e.observer] = e.dest
		end
		sentOrig(e)
		if e.origin then
			-- the name on it did not say this; its courier set off elsewhere
			local claimed = ctx.agent(e.observer)
			if claimed then
				claimed.bubbleToken += 1
				claimed.bubble.Visible = false
			end
			if e.origin ~= "gate" then
				local mk = e.detail.kind == "quote_response" and string.format("%s¢ each", tostring(e.detail.body and e.detail.body.unit_cents))
					or e.detail.kind == "invoice" and ("Invoice → pay " .. tostring(e.detail.body and e.detail.body.pay_to))
					or nil
				if mk then
					E.setBubble(ctx.agent(e.origin), mk, 2.6)
				end
			end
		end
		local env = ctx.envelopes[e.subject]
		if env then
			self:addFlaggable(env.part, e.subject)
		end
		if e.origin == "gate" then
			Replay.effects.flash(town.buildings.auth, Color3.fromRGB(255, 120, 60))
		end
	end

	local dupOrig = h.message_duplicated
	h.message_duplicated = function(e)
		dupOrig(e)
		local env = ctx.envelopes[e.subject .. "#dup"]
		if env then
			self:addFlaggable(env.part, e.subject)
		end
	end

	local delivOrig = h.message_delivered
	h.message_delivered = function(e)
		local env = ctx.envelopes[e.subject]
		if e.detail.kind == "invoice" and env and env.part and env.part.Parent then
			-- the invoice sits on the buyer's desk until it is paid
			local p = env.part
			local a = ctx.agent(e.detail.to)
			p:SetAttribute("Landed", true)
			if a then
				p.CFrame = CFrame.new(a.top + Vector3.new(4.5, -2, 0)) * CFrame.Angles(0, 0, math.rad(12))
			end
			self.lastPos[e.subject] = p.Position
			Util.delay((e.hold or 0.6) + 0.25, function()
				if p.Parent then
					Util.animate(0.35, function(al)
						p.Size = p.Size:Lerp(Vector3.new(0.2, 0.2, 0.2), al)
					end, function()
						p:Destroy()
					end)
				end
			end)
			return
		end
		delivOrig(e)
		-- a live town delivers all round: crates are carried off after a while
		if e.detail.kind == "delivery" and e.copy ~= 2 and env and env.part then
			local crate = env.part
			local a = ctx.agent(e.detail.to)
			Util.delay(7, function()
				if crate.Parent then
					crate:Destroy()
					if a then
						a.crates = math.max(0, a.crates - 1)
					end
				end
			end)
		end
	end

	h.message_delayed = function(e)
		local pos = self:where(e.subject)
		if e.detail.fault == "false_alarm" then
			local env = ctx.envelopes[e.subject]
			if env and env.part and env.part.Parent then
				local p = env.part
				local was = p.Color
				p.Color = Color3.fromRGB(140, 140, 150)
				Util.delay(e.detail.delay or 4, function()
					if p.Parent then
						p.Color = was
					end
				end)
			end
			floatAt(pos, "⏸ held " .. tostring(e.detail.delay) .. " s", Color3.fromRGB(255, 190, 80))
		else
			floatAt(pos, "⏳ delayed", Color3.fromRGB(255, 180, 60))
		end
	end

	h.negotiation_abandoned = function(e)
		E.setBubble(ctx.agent(e.observer), "✗ deal off: " .. tostring(e.detail.reason), 3.0, Color3.fromRGB(255, 215, 200))
		ctx.closeDeal(nil, e.subject)
	end

	h.message_unhandled = function(e)
		E.setBubble(ctx.agent(e.observer), "ignoring that " .. tostring(e.detail.kind), 2.0, Color3.fromRGB(235, 235, 235))
	end

	-- the game ---------------------------------------------------------

	h.threat_caught = function(e)
		local pos = self:where(e.detail.target)
		burst(pos, BLUE)
		floatAt(pos, "✓ CAUGHT +" .. tostring(e.detail.points), BLUE, 3.5)
	end
	h.threat_escaped = function(e)
		local a = ctx.agent(Config.ATTACKER)
		-- a little to the right of the stall, so the overview's left edge never clips it
		local pos = (a and a.top or View.RED_STALL) + Vector3.new(10, 0, 0)
		burst(pos, RED)
		floatAt(pos, "✗ ESCAPED +" .. tostring(e.detail.points) .. " RED", RED, 3.5)
	end
	h.false_alarm = function(e)
		local pos = self:where(e.subject)
		burst(pos, Color3.fromRGB(255, 170, 60))
		floatAt(pos, "FALSE ALARM " .. tostring(e.detail.points), Color3.fromRGB(255, 170, 60), 3.0)
	end
	h.layer_swapped = function(e)
		self.layers[e.subject] = e.detail.to
		self:applyLayers(true)
		if e.subject == "auth" then
			local gate = town.buildings.auth
			floatAt(gate.anchor + Vector3.new(8, 4, 0), e.detail.to == "hmac.v1" and "guards back on duty" or "guards leave the gate", Color3.fromRGB(255, 120, 120), 3.5)
		else
			local reg = town.buildings.registry
			floatAt(reg.anchor + Vector3.new(0, 4, 2), e.detail.to == "index.owned.v1" and "🔒 board locked" or "board unlocked", Color3.fromRGB(120, 230, 140), 3.5)
		end
		local b = self.stage.hud:banner(string.format("COUNCIL: %s → %s", e.subject, tostring(e.detail.to)), Color3.fromRGB(200, 160, 255))
		Util.delay(3.5, function()
			b:Destroy()
		end)
		self.myVotes[e.subject] = nil
	end
	h.round_finished = function(e)
		self:showResults(e.detail)
	end
	h.round_started = function(_e) end
end

------------------------------------------------------------------------ the stream

function View:receive(batch)
	if self.stopped then
		return
	end
	for _, e in batch do
		if e.kind == "round_started" then
			if not e.snapshot or not self.stage or self.round ~= e.detail.round then
				self.round = e.detail.round
				self:hideResults()
				self:build(e.detail.layers or {})
			end
		end
		if self.stage then
			self.stage.handle(e)
		end
	end
end

------------------------------------------------------------------------ input

function View:click(screen: Vector2)
	if myTeam() ~= "blue" then
		return
	end
	local id = self:pick(screen)
	self.remotes.Flag:FireServer(id or "", self.opts.getMode())
	-- a ring where you clicked
	local ring = Instance.new("Frame")
	ring.AnchorPoint = Vector2.new(0.5, 0.5)
	ring.Position = UDim2.fromOffset(screen.X, screen.Y)
	ring.Size = UDim2.fromOffset(10, 10)
	ring.BackgroundTransparency = 1
	ring.Parent = self.gui
	Util.corner(ring, 40)
	local s = Instance.new("UIStroke")
	s.Color = id and BLUE or Color3.fromRGB(200, 200, 200)
	s.Thickness = 3
	s.Parent = ring
	Util.animate(0.4, function(a)
		ring.Size = UDim2.fromOffset(10 + 60 * a, 10 + 60 * a)
		s.Transparency = a
	end, function()
		ring:Destroy()
	end)
end

function View:bindInput()
	self.selection = Instance.new("SelectionBox")
	self.selection.Name = "RBHover"
	self.selection.Color3 = BLUE
	self.selection.LineThickness = 0.15
	self.selection.SurfaceTransparency = 0.7
	self.selection.SurfaceColor3 = BLUE
	self.selection.Parent = self.gui

	self:connect(UserInputService.InputBegan, function(input, processed)
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			self:click(Vector2.new(input.Position.X, input.Position.Y))
		end
	end)
	self:connect(workspace:GetAttributeChangedSignal("RBClickAt"), function()
		local v = workspace:GetAttribute("RBClickAt")
		if typeof(v) == "Vector2" then
			workspace:SetAttribute("RBClickAt", nil)
			self:click(v)
		end
	end)
	self:connect(workspace:GetAttributeChangedSignal("RBVote"), function()
		local v = workspace:GetAttribute("RBVote")
		if type(v) == "string" and v ~= "" then
			workspace:SetAttribute("RBVote", nil)
			self.remotes.Vote:FireServer(v)
		end
	end)
	-- L: scripted <-> model-driven, by key or by automation
	self:connect(UserInputService.InputBegan, function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.L then
			self.remotes.Llm:FireServer("toggle")
		end
	end)
	self:connect(workspace:GetAttributeChangedSignal("RBLlm"), function()
		local v = workspace:GetAttribute("RBLlm")
		if type(v) == "string" and v ~= "" then
			workspace:SetAttribute("RBLlm", nil)
			self.remotes.Llm:FireServer(v)
		end
	end)

	local lastMode, lastSent = nil, 0
	self:connect(RunService.RenderStepped, function()
		local team = myTeam()
		workspace:SetAttribute("RBTeam", team or "")
		-- hover: what a click would flag (mouse only)
		local hoverId, hoverPart = nil, nil
		if team == "blue" and UserInputService.MouseEnabled then
			hoverId, hoverPart = self:pick(UserInputService:GetMouseLocation())
		end
		self.selection.Adornee = hoverPart
		workspace:SetAttribute("RBHover", hoverId or "")
		local n = 0
		for part, id in self.flaggables do
			if part.Parent then
				n += 1
				self.lastPos[id] = part.Position
			end
		end
		workspace:SetAttribute("RBFlaggables", n)
		-- camera mode, for the watcher telemetry
		local now = os.clock()
		if now - lastSent > 0.5 then
			lastSent = now
			local mode = self.opts.getMode()
			local char = Players.LocalPlayer.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if mode == "walk" and hrp and hrp.Position.Y > 30 then
				mode = "tower"
			end
			if mode ~= lastMode then
				lastMode = mode
				self.remotes.Camera:FireServer(mode)
			end
		end
		self:refreshHud(team)
		self:refreshLlm()
		self:refreshPrompts(team)
	end)
end

-- Red's attack prompts are only offered to red (locally; the server checks too).
function View:refreshPrompts(team: string?)
	local props = workspace:FindFirstChild("NandaPlay")
	local rb = props and props:FindFirstChild("RedBlue")
	if not rb then
		return
	end
	for _, d in rb:GetDescendants() do
		if d:IsA("ProximityPrompt") and d:GetAttribute("RedOnly") then
			d.Enabled = team == "red"
		end
	end
end

