local function attr(name: string, default: any): any
	local v = workspace:GetAttribute(name)
	if v == nil then
		return default
	end
	return v
end

function View:refreshHud(team: string?)
	local phase = attr("RB_Phase", "idle")
	local left = math.max(0, attr("RB_Ends", 0) - workspace:GetServerTimeNow())
	local clock = string.format("%d:%02d", math.floor(left / 60), math.floor(left % 60))
	local tokens = attr("RB_Tokens", 0)
	local pips = string.rep("◆", tokens) .. string.rep("◇", math.max(0, Config.TOKENS_PER_ROUND - tokens))
	local you = Players.LocalPlayer.DisplayName
	local redWho = attr("RB_RedBot", false) and " (RedBot)" or (team == "red" and " (you)" or "")
	local blueWho = attr("RB_BlueBot", false) and " (BlueBot)" or (team == "blue" and " (you)" or "")
	self.scoreText.Text = string.format(
		"%s %s   <font color='%s'>RED %d</font> <font color='%s'>%s</font>%s   <font color='%s'>BLUE %d</font>%s   TOWN <b>%d</b> deals",
		phase == "results" and "NEXT ROUND IN" or ("ROUND " .. tostring(attr("RB_Round", 0)) .. " ·"),
		clock,
		hex(RED),
		attr("RB_Red", 0),
		hex(RED),
		pips,
		redWho,
		hex(BLUE),
		attr("RB_Blue", 0),
		blueWho,
		attr("RB_Deals", 0)
	)
	local auth, registry = attr("RB_Auth", "hmac.v1"), attr("RB_Registry", "index.v1")
	if team == "red" then
		self.rolePanel.BackgroundColor3 = Color3.fromRGB(60, 18, 18)
		self.roleText.Text = string.format(
			"<font color='%s'><b>RED TEAM</b></font> · %s, %d attack%s left this round\n"
				.. "• <b>Forge an invoice</b> at the GATE (E): works only with no guards (auth plain.v1)\n"
				.. "• <b>Spoof a card</b> at the NOTICE BOARD (E): works only on an open board (registry index.v1)\n"
				.. "An attack that pays out before blue flags it: <b>+%d</b>",
			hex(RED),
			you,
			tokens,
			tokens == 1 and "" or "s",
			Config.ESCAPE_POINTS
		)
	elseif team == "blue" then
		self.rolePanel.BackgroundColor3 = Color3.fromRGB(16, 28, 60)
		self.roleText.Text = string.format(
			"<font color='%s'><b>BLUE TEAM</b></font> · %s, you hold the WATCHTOWER (climb it, or V / F)\n"
				.. "Click a suspicious courier or card: catch <b>+%d</b>, false alarm <b>%d</b>\n"
				.. "Tells: a courier that sets off from the <b>gate</b> · a payee not on the board · <b>two cards with one name</b> · a card marked UNVERIFIED · couriers to the red-team stall",
			hex(BLUE),
			you,
			Config.CATCH_POINTS,
			Config.FALSE_ALARM_POINTS
		)
	else
		self.rolePanel.BackgroundColor3 = PANEL
		self.roleText.Text = "<b>RED vs. BLUE · live</b>\n"
			.. "Pick a side: step on the <font color='#ff6060'><b>RED</b></font> or <font color='#70a0ff'><b>BLUE</b></font> pad by the spawn. "
			.. "Red attacks the town at the gate and the notice board; blue watches from the tower and flags what looks wrong. "
			.. "Until a side has a human, a bot plays it. Everyone votes in the council."
	end
	local present, needed = attr("RB_Present", 1), attr("RB_Needed", 1)
	self.councilNote.Text = string.format("a swap needs %d of the %d players here", needed, present)
	for layer, row in self.lawRows do
		local cur = layer == "auth" and auth or registry
		local opts = Config.LAYER_OPTIONS[layer]
		local other = cur == opts[1] and opts[2] or opts[1]
		local strong = (layer == "auth" and cur == "hmac.v1") or (layer == "registry" and cur == "index.owned.v1")
		row.law.Text = string.format("%s: <b>%s</b>  <font color='%s'>%s</font>", layer, cur, strong and "#78e68c" or "#ffb060", strong and (layer == "auth" and "guards check signatures" or "listings owned by their key") or (layer == "auth" and "no signature checks" or "anyone may list any name"))
		local votes = attr(layer == "auth" and "RB_VoteAuth" or "RB_VoteRegistry", 0)
		local mine = self.myVotes[layer] == true
		row.button.Text = string.format("%s switch to <b>%s</b>   %d/%d", mine and "✓ you voted:" or "vote:", other, votes, needed)
		row.button.BackgroundColor3 = mine and Color3.fromRGB(120, 80, 190) or Color3.fromRGB(60, 45, 90)
	end
end

------------------------------------------------------- model-driven agents

-- What the server says about the harness (RB_Llm, a JSON blob it only
-- rewrites when something changes).
function View:readLlm()
	local json = workspace:GetAttribute("RB_Llm")
	if json == self.llmJson then
		return false
	end
	self.llmJson = json
	local ok, d = pcall(function()
		return HttpService:JSONDecode(json or "")
	end)
	self.llm = (ok and type(d) == "table") and d or nil
	return true
end

local HEALTH = {
	off = "",
	waiting = "waiting for the harness at %s",
	ok = "harness: %d decisions, %s per decision",
	no_key = "the harness has no API key: scripted until it does",
	error = "the harness is not answering (%s): scripted until it does",
}

function View:refreshLlm()
	local changed = self:readLlm()
	local d = self.llm
	local driven = d and d.agents or {}
	-- the nameplates: the town is rebuilt every round, so watch for that too
	if changed or self.llmTown ~= self.town then
		self.llmTown = self.town
		self:markAgents(driven)
	end
	if not changed then
		return
	end
	local nextLabel = "L: make seller-b model-driven"
	local presets = Config.LLM_PRESETS
	local here = table.concat((function()
		local names = {}
		for _, a in driven do
			table.insert(names, a.name)
		end
		table.sort(names)
		return names
	end)(), ",")
	for i, p in presets do
		if table.concat(p, ",") == here then
			local nxt = presets[(i % #presets) + 1]
			nextLabel = #nxt == 0 and "L: back to scripted" or ("L: make " .. table.concat(nxt, " and ") .. " model-driven")
			break
		end
	end
	self.llmButton.Text = nextLabel
	if #driven == 0 then
		self.llmButton.BackgroundColor3 = Color3.fromRGB(60, 45, 90)
		self.agentsText.Text = "<b>Every trader is scripted Luau</b> from this repo: the deal cycle in "
			.. "RedBlue/TownSim.luau, the decisions in RedBlue/Policy.luau.\n"
			.. "A language model can drive one of them through an external harness."
		return
	end
	self.llmButton.BackgroundColor3 = Color3.fromRGB(95, 60, 170)
	local lines = {}
	for _, a in driven do
		table.insert(
			lines,
			string.format(
				"<font color='%s'><b>%s</b></font> · %s · %s",
				hex(VIOLET),
				a.name,
				a.model or d.model or Config.LLM_MODEL,
				a.source == "llm" and "model-driven" or "scripted (no answer yet)"
			)
		)
		if a.line then
			table.insert(lines, a.line)
		end
	end
	local tail = HEALTH[d.health or "off"]
	if d.health == "ok" then
		tail = string.format(tail, d.actions or 0, d.roundTrip and string.format("%.1f s", d.roundTrip / 1000) or "?")
	elseif d.health == "waiting" then
		tail = string.format(tail, d.url or "")
	elseif d.health == "error" then
		tail = string.format(tail, d.error or "?")
	end
	if tail ~= "" then
		table.insert(lines, "<font color='#a0a0b0'>" .. tail .. "</font>")
	end
	self.agentsText.Text = table.concat(lines, "\n")
end

-- A model-driven agent wears a violet nameplate with the model's name where
-- its role usually is. Everyone else keeps the plate the replay gave them.
function View:markAgents(driven)
	if not self.town then
		return
	end
	self.plateWas = self.plateWas or {}
	local want = {}
	for _, a in driven do
		want[a.name] = a
	end
	for name, agent in self.town.agents do
		local plate = agent.hud and agent.hud:FindFirstChild("Plate", true)
		local role = plate and plate:FindFirstChild("Balance") :: TextLabel?
		local stroke = plate and plate:FindFirstChildOfClass("UIStroke")
		if plate and role then
			local was = self.plateWas[plate]
			if not was then
				was = { text = role.Text, color = role.TextColor3, stroke = stroke and stroke.Color, size = plate.Size }
				self.plateWas[plate] = was
			end
			local a = want[name]
			if a then
				role.Text = a.model or Config.LLM_MODEL
				role.TextColor3 = VIOLET
				plate.Size = UDim2.fromOffset(200, 44)
				if stroke then
					stroke.Color = VIOLET
					stroke.Thickness = 3.5
				end
			else
				role.Text = was.text
				role.TextColor3 = was.color
				plate.Size = was.size
				if stroke and was.stroke then
					stroke.Color = was.stroke
					stroke.Thickness = 2.5
				end
			end
		end
	end
end

function View:notice(n)
	if type(n) ~= "table" then
		return
	end
	if n.kind == "vote" and n.layer then
		self.myVotes[n.layer] = n.yes == true
	end
	if n.text then
		self.toastToken += 1
		local token = self.toastToken
		self.toast.Text = n.text
		self.toast.TextColor3 = n.color == "red" and Color3.fromRGB(255, 140, 140) or n.color == "blue" and Color3.fromRGB(150, 190, 255) or n.color == "gold" and GOLD or Color3.new(1, 1, 1)
		self.toast.Visible = true
		workspace:SetAttribute("RBLastNotice", n.text)
		task.delay(n.seconds or 3.5, function()
			if self.toastToken == token then
				self.toast.Visible = false
			end
		end)
	end
end

function View:showResults(d)
	local w = d.winner == "red" and "RED WINS THE ROUND" or "BLUE HOLDS THE TOWN"
	self.resultsText.Text = string.format(
		"<font size='30' color='%s'><b>%s</b></font>\nRound %s · <font color='%s'>RED %s</font> · <font color='%s'>BLUE %s</font>\n"
			.. "%s escaped · %s caught · %s blocked by the layers · %s false alarm%s\n"
			.. "Town economy: <b>%s deals</b> settled under auth %s, registry %s\n<font size='16'>next round shortly · the council can vote now</font>",
		hex(d.winner == "red" and RED or BLUE),
		w,
		tostring(d.round),
		hex(RED),
		tostring(d.red),
		hex(BLUE),
		tostring(d.blue),
		tostring(d.escapes),
		tostring(d.catches),
		tostring(d.blocked),
		tostring(d.false_alarms),
		d.false_alarms == 1 and "" or "s",
		tostring(d.deals),
		tostring(d.layers and d.layers.auth),
		tostring(d.layers and d.layers.registry)
	)
	self.results.Visible = true
end

function View:hideResults()
	if self.results then
		self.results.Visible = false
	end
end

return View
