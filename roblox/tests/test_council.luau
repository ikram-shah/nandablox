-- The council: majority of players present carries a layer swap.

local lib = require("./lib")

return function(t)
	t.case("a strict majority of those present", function(A)
		local needed = lib.Council.needed
		A.eq(needed(1), 1)
		A.eq(needed(2), 2)
		A.eq(needed(3), 2)
		A.eq(needed(4), 3)
		A.eq(needed(5), 3)
		A.eq(needed(10), 6)
	end)

	t.case("votes toggle, count per proposal, and leave with the player", function(A)
		local c = lib.Council.new({ auth = true, registry = true })
		A.eq(c:toggle("p1", "auth"), true)
		A.eq(c:toggle("p2", "auth"), true)
		A.eq(c:toggle("p2", "registry"), true)
		A.eq(c:count("auth"), 2)
		A.eq(c:count("registry"), 1)
		A.eq(c:toggle("p1", "auth"), false, "toggled off")
		A.eq(c:count("auth"), 1)
		A.ok(not c:passes("auth", 3))
		c:toggle("p3", "auth")
		A.ok(c:passes("auth", 3), "2 of 3")
		c:remove("p2")
		A.eq(c:count("auth"), 1)
		A.eq(c:count("registry"), 0)
		A.eq(c:toggle("p1", "bogus"), nil)
		A.ok(not c:passes("auth", 0), "nobody present, nothing passes")
	end)

	t.case("solo: one vote swaps auth to plain.v1, and forgeries get through", function(A)
		local g = lib.Game.new({ config = lib.quiet({ RED_BOT = "off", BLUE_BOT = "off" }), seed = 2 })
		g:join("p", "Peter")
		g:setTeam("p", "red")
		g:start(0)
		lib.runGame(g, 20)
		local _, _, th1 = g:attack("p", "forge")
		A.eq(th1.state, "blocked", "hmac.v1 by default")
		A.eq(g:vote("p", "auth"), true)
		local evs = g:drain()
		local sw = lib.first(evs, function(e)
			return e.kind == "layer_swapped"
		end)
		A.ok(sw, "layer_swapped")
		A.eq(sw.subject, "auth")
		A.eq(sw.detail.from, "hmac.v1")
		A.eq(sw.detail.to, "plain.v1")
		A.eq(g.layers.auth, "plain.v1")
		A.eq(g.sim.layers.auth, "plain.v1", "the running town swapped too")
		A.eq(g.council:count("auth"), 0, "votes cleared once carried")
		lib.runGame(g, g.t + 5)
		local _, _, th2 = g:attack("p", "forge")
		A.eq(th2.state, "live", "no guards now")
		-- and back again
		g:vote("p", "auth")
		A.eq(g.layers.auth, "hmac.v1")
	end)

	t.case("two players: one vote waits, the second carries index.owned.v1", function(A)
		local g = lib.Game.new({ config = lib.quiet({ RED_BOT = "off", BLUE_BOT = "off" }), seed = 4 })
		g:join("a", "A")
		g:join("b", "B")
		g:setTeam("a", "blue")
		g:start(0)
		lib.runGame(g, 5)
		g:vote("a", "registry")
		A.eq(g.layers.registry, "index.v1", "1 of 2 is not a majority")
		A.eq(g:status().voteRegistry, 1)
		A.eq(g:status().needed, 2)
		g:vote("b", "registry")
		A.eq(g.layers.registry, "index.owned.v1")
	end)

	t.case("a vote in the results break carries into the next round", function(A)
		local g = lib.Game.new({ config = lib.quiet({ RED_BOT = "off", BLUE_BOT = "off" }), seed = 6 })
		g:join("a", "A")
		g:start(0)
		lib.runGame(g, 181)
		A.eq(g.phase, "results")
		g:vote("a", "registry")
		A.eq(g.layers.registry, "index.owned.v1")
		lib.runGame(g, 194)
		A.eq(g.phase, "play")
		A.eq(g.sim.layers.registry, "index.owned.v1")
	end)

	t.case("when a voter leaves, a standing majority can carry", function(A)
		local g = lib.Game.new({ config = lib.quiet({ RED_BOT = "off", BLUE_BOT = "off" }), seed = 8 })
		g:join("a", "A")
		g:join("b", "B")
		g:join("c", "C")
		g:start(0)
		g:vote("a", "auth")
		A.eq(g.layers.auth, "hmac.v1", "1 of 3")
		g:leave("c")
		g:leave("b")
		A.eq(g.layers.auth, "plain.v1", "1 of 1 now")
	end)
end
